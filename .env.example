# Optional Windows desktop developer proxy / Huawei Cloud deployment.
# Put real credentials in server/.env or secret variables on your server only.
NODE_ENV=development
PORT=3000
DESKTOP_ORIGIN=http://127.0.0.1:5173

# ===== 业务后端（B 套餐）=====
# 业务后端的完整变量清单见 server/.env.example。
# 本地开发默认：
#   DATABASE_URL=mysql://smart_store:smart_store_dev@127.0.0.1:3306/smart_store
#   REDIS_URL=redis://127.0.0.1:6379
#   CACHE_DRIVER=auto
# 生产环境必须关闭：
#   ALLOW_DEMO_LOGIN=false
#   ALLOW_DEMO_PAYMENT=false
# 微信凭据只放服务端：
#   WECHAT_APP_ID=
#   WECHAT_APP_SECRET=

# ===== 桌面生成器模型代理 =====
# Local/cloud server side only. Never place these values in the Electron UI bundle.
# IMAGE_API_BASE_URL must be the HTTPS base endpoint of a tested OpenAI-compatible model API.
# A Huawei Cloud native ModelArts endpoint must be checked for API and signing compatibility
# before you claim that it is connected. If native IAM signing is needed, implement a server adapter.
IMAGE_PROVIDER_NAME=not-configured
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL_NAME=
VISION_MODEL_NAME=
IMAGE_API_TIMEOUT_MS=60000

# Point the React UI to the server API base. Empty keeps the explicit offline demo mode.
# Example: http://127.0.0.1:3000/api/v1/generation
VITE_IMAGE_MODEL_ENDPOINT=