        "activeId",
        "categories"
      ],
      "events": [
        "select"
      ]
    },
    "error-banner": {
      "props": [
        "action",
        "message",
        "requestId"
      ],
      "events": [
        "close",
        "retry"
      ]
    },
    "fulfillment-switch": {
      "props": [
        "dineInEnabled",
        "tableName",
