      {
        "lineStart": 2,
        "lineEnd": 23,
        "code": "<view class=\"merchant__head\">\r\n    <view class=\"merchant__head-top\">\r\n      <view class=\"merchant__head-main\">\r\n        <text class=\"merchant__eyebrow\">店主工作台</text>\r\n        <text class=\"merchant__title\">{{storeName || storeId || '门店'}}</text>\r\n      </view>\r\n      <view class=\"merchant__role\">{{roleLabel || '—'}}</view>\r\n    </view>\r\n    <view class=\"merchant__meta\">\r\n      <text>{{lastUpdated || '尚未刷新'}}</text>\r\n      <text wx:if=\"{{allowed}}\" class=\"merchant__polling\">\r\n        {{polling ? '每 10 秒自动刷新' : '自动刷新已暂停'}}\r\n      </text>\r\n    </view>\r\n    <view wx:if=\"{{allowed}}\" class=\"merchant__actions\">\r\n      <view class=\"merchant__refresh\" bind:tap=\"onRefresh\">立即刷新</view>\r\n      <view class=\"merchant__poll-switch\">\r\n        <text class=\"merchant__poll-label\">自动刷新</text>\r\n        <switch checked=\"{{polling}}\" color=\"#E86A17\" bindchange=\"onTogglePolling\" />\r\n      </view>\r\n    </view>\r\n  </view>"
      }
    ]
  },
