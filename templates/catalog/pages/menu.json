      "componentId": "product-card",
      "mode": "always",
      "sourceLine": 76,
      "usage": "<product-card id=\"menu-product-{{item.id}}\" class=\"menu__card-host\" product=\"{{item}}\" quantity=\"{{quantityMap[item.id] || 0}}\" disabled=\"{{item.available === false}}\" bind:add=\"onProductAdd\" bind:rem"
    },
    {
      "tag": "cart-bar",
      "componentId": "cart-bar",
      "mode": "always",
      "sourceLine": 99,
      "usage": "<cart-bar id=\"menu-cart-bar\" class=\"menu__cart-host\" total-cents=\"{{cartSummary.totalCents}}\" total-quantity=\"{{cartSummary.totalQuantity}}\" submitting=\"{{false}}\" bind:expand=\"onExpandCart\" bind:chec"
    },
    {
      "tag": "cart-panel",
      "componentId": "cart-panel",
      "mode": "modal",
      "sourceLine": 109,
      "usage": "<cart-panel visible=\"{{cartVisible}}\" items=\"{{cartSummary.items}}\" total-cents=\"{{cartSummary.totalCents}}\" total-quantity=\"{{cartSummary.totalQuantity}}\" submitting=\"{{false}}\" bind:close=\"onPanelCl"
    },
    {
      "tag": "product-detail",
      "componentId": "product-detail",
      "mode": "modal",
      "sourceLine": 121,
      "usage": "<product-detail visible=\"{{detailVisible}}\" product=\"{{detailProduct}}\" quantity=\"{{detailQuantity}}\" bind:close=\"onDetailClose\" bind:add=\"onDetailAdd\" bind:remove=\"onDetailRemove\" />"
    },
