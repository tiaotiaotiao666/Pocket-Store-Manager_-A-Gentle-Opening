{
  "schemaVersion": "page-catalog-entry.v1",
  "pageId": "product-detail",
  "title": "商品详情",
  "audience": "customer",
  "required": true,
  "summary": "独立商品详情页：商品信息、加购、购物车条与购物车面板。",
  "source": {
    "root": "templates/base/ordering-base/1.0.0/src/pages/product-detail",
    "files": [
      "index.js",
