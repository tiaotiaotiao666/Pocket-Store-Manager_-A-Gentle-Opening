        "code": "<view class=\"surface-card checkout__card\">\r\n        <view class=\"checkout__card-head\">\r\n          <text class=\"checkout__card-title\">菜品明细</text>\r\n          <text class=\"checkout__card-extra\">{{totalQuantity}} 件</text>\r\n        </view>\r\n        <view class=\"checkout__divider\"></view>\r\n        <view wx:for=\"{{items}}\" wx:key=\"productId\" class=\"checkout__item\">\r\n          <view class=\"checkout__item-main\">\r\n            <text class=\"checkout__item-name\">{{item.name}}</text>\r\n            <text class=\"checkout__item-unit\">{{item.unitPriceText}} × {{item.quantity}}</text>\r\n          </view>\r\n          <text class=\"checkout__item-line\">{{item.lineTotalText}}</text>\r\n        </view>\r\n        <view class=\"checkout__divider\"></view>\r\n        <view class=\"checkout__total\">\r\n          <text class=\"checkout__total-label\">合计（服务端将重新计价）</text>\r\n          <text class=\"checkout__total-value\">{{totalText}}</text>\r\n        </view>\r\n      </view>"
      }
