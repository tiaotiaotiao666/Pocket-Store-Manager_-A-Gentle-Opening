<view class="menu c4-menu">
  <view class="c4-menu__hero">
    <text class="c4-menu__hero-title">今日推荐 · 现炒上桌</text>
    <text class="c4-menu__hero-sub">分类导航放宽间距，商品卡图片更突出</text>
  </view>
  <view class="menu__top">
    <store-header
      store-name="{{store.name || '菜单'}}"
      table-name="{{tableName}}"
      business-hours="{{store.businessHours || ''}}"
      mode="{{mode}}"
      address="{{store.address || ''}}"
      compact="{{true}}"
    />
    <view class="menu__switch">
      <fulfillment-switch
        value="{{mode}}"
        dine-in-enabled="{{store.fulfillment.dineIn}}"
        takeaway-enabled="{{store.fulfillment.takeaway}}"
        table-name="{{tableName}}"
        table-required="{{true}}"
        table-count="{{tableOptions.length}}"
        tables-loading="{{tablesLoading}}"
        bind:change="onModeChange"
      />
      <view wx:if="{{mode === 'DINE_IN'}}" class="menu__tables">
        <view class="menu__tables-head">
          <text class="menu__tables-title">选择桌号</text>
          <text wx:if="{{tableName}}" class="menu__tables-picked">已选 {{tableName}} 桌</text>
        </view>
        <view wx:if="{{tablesLoading}}" class="menu__tables-status">
          <text class="menu__tables-hint">正在读取门店桌号…</text>
        </view>
        <view wx:elif="{{tablesError}}" class="menu__tables-status">
          <text class="menu__tables-hint">{{tablesError}}</text>
          <view class="menu__tables-retry" bind:tap="onRetryTables">重试</view>
        </view>
        <view wx:elif="{{tableOptions.length === 0}}" class="menu__tables-status">
          <text class="menu__tables-hint">当前门店还没有可用桌号，请联系店员确认</text>
        </view>
        <scroll-view wx:else class="menu__tables-scroll" scroll-x enable-flex>
          <view class="menu__tables-list">
            <view
              wx:for="{{tableOptions}}"
              wx:key="id"
              class="menu__table {{tableName === item.name ? 'menu__table--active' : ''}}"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              bind:tap="onPickTable"
            >
              {{item.name}}
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在加载菜单" />

  <view wx:elif="{{error}}" class="menu__error">
    <error-banner message="{{error}}" action="{{errorAction}}" request-id="{{requestId}}" bind:retry="onRetry" bind:close="onRetry" />
    <view class="ghost-button menu__retry" bind:tap="onRetry">重新加载</view>
  </view>

  <view wx:else class="menu__body">
    <!-- @slot:menu-hero -->
    <!-- @slot-fallback:menu-hero -->
    <!-- @slot-fallback:menu-hero:end -->
    <!-- @slot:menu-hero:end -->
    <!-- @slot:menu-aside -->
    <!-- @slot-fallback:menu-aside -->
    <!-- @slot-fallback:menu-aside:end -->
    <!-- @slot:menu-aside:end -->
    <category-nav id="menu-category-nav" class="menu__nav-host" categories="{{categories}}" active-id="{{activeCategoryId}}" bind:select="onSelectCategory" />
    <scroll-view class="menu__list" scroll-y>
      <view class="menu__banner">
        <view class="menu__banner-text">
          <text class="menu__banner-title">{{activeCategoryName || '全部菜品'}}</text>
          <text class="menu__banner-sub">{{products.length}} 道菜 · 价格为整数分展示</text>
        </view>
        <view class="menu__banner-tag">{{tableName ? tableName + ' 桌' : '自取'}}</view>
      </view>

      <view wx:if="{{products.length > 0}}" class="menu__products">
        <view wx:for="{{products}}" wx:key="id" class="menu__product c4-menu__product">
          <product-card
            id="menu-product-{{item.id}}"
            class="menu__card-host"
            product="{{item}}"
            quantity="{{quantityMap[item.id] || 0}}"
            disabled="{{item.available === false}}"
            bind:add="onProductAdd"
            bind:remove="onProductRemove"
            bind:openDetail="onOpenDetail"
          />
        </view>
      </view>
      <state-view
        wx:else
        state="empty"
        title="这个分类还没有上架菜品"
        description="换一个分类看看，或稍后下拉刷新"
      />

      <view class="menu__spacer"></view>
    </scroll-view>
  </view>

  <cart-bar
    id="menu-cart-bar"
    class="menu__cart-host"
    total-cents="{{cartSummary.totalCents}}"
    total-quantity="{{cartSummary.totalQuantity}}"
    submitting="{{false}}"
    bind:expand="onExpandCart"
    bind:checkout="onCheckout"
  />

  <cart-panel
    visible="{{cartVisible}}"
    items="{{cartSummary.items}}"
    total-cents="{{cartSummary.totalCents}}"
    total-quantity="{{cartSummary.totalQuantity}}"
    submitting="{{false}}"
    bind:close="onPanelClose"
    bind:add="onPanelAdd"
    bind:remove="onPanelRemove"
    bind:checkout="onCheckout"
  />

  <product-detail
    visible="{{detailVisible}}"
    product="{{detailProduct}}"
    quantity="{{detailQuantity}}"
    bind:close="onDetailClose"
    bind:add="onDetailAdd"
    bind:remove="onDetailRemove"
  />
</view>
