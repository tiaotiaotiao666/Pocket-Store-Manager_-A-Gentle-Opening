.fp-home {
  padding-top: 20rpx;
}

.fp-home__hero {
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(35, 35, 35, 0.12);
}

.fp-home__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 34rpx 0 24rpx;
}

.fp-home__brand {
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.fp-home__eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--color-primary);
}

.fp-home__title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.fp-home__sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--color-muted);
}

.fp-home__identity {
  display: flex;
  align-items: center;
  flex: none;
  max-width: 210rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 21rpx;
  color: var(--color-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fp-home__identity-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: var(--color-success);
}

.fp-home__error {
  margin-top: 24rpx;
}

.fp-home__retry {
  margin-top: 22rpx;
}

.fp-home__hint {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(47, 125, 79, 0.09);
  color: var(--color-success);
  font-size: 22rpx;
}

.fp-home__marketing {
  margin-top: 4rpx;
}

.fp-home__section {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
}

.fp-home__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.fp-home__section-title {
  font-size: 28rpx;
  font-weight: 700;
}

.fp-home__section-extra {
  font-size: 22rpx;
  color: var(--color-muted);
}

.fp-home__tables {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.fp-home__tables-label {
  margin-right: 14rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.fp-home__table {
  margin-right: 12rpx;
  padding: 9rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 23rpx;
  font-weight: 600;
}

.fp-home__cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 28rpx 30rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
  color: #fffdf9;
  box-shadow: 0 16rpx 34rpx rgba(179, 74, 15, 0.28);
}

.fp-home__cta-copy {
  display: flex;
  flex-direction: column;
}

.fp-home__cta-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.fp-home__cta-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 253, 249, 0.72);
}

.fp-home__cta-arrow {
  font-size: 42rpx;
  font-weight: 300;
}

.fp-home__notice {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fdf0e4;
  border: 2rpx solid rgba(179, 74, 15, 0.18);
}

.fp-home__notice-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.fp-home__notice-text {
  flex: 1;
  font-size: 23rpx;
  color: #8a5a2b;
}

.fp-home__notice-arrow {
  font-size: 22rpx;
  color: #a8691f;
}

.fp-home__orders {
  margin-top: 34rpx;
}

.fp-home__order {
  margin-bottom: 18rpx;
}

.fp-home__merchant {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, var(--color-text) 0%, #3a3430 100%);
  color: var(--color-surface);
  box-shadow: 0 14rpx 32rpx rgba(35, 35, 35, 0.2);
}

.fp-home__merchant-body {
  display: flex;
  flex-direction: column;
}

.fp-home__merchant-title {
  font-size: 30rpx;
  font-weight: 700;
}

.fp-home__merchant-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 250, 243, 0.62);
}

.fp-home__merchant-arrow {
  font-size: 40rpx;
  color: rgba(255, 250, 243, 0.6);
}

.fp-home__foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(138, 129, 120, 0.7);
}