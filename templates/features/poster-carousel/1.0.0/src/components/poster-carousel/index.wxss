@import "../../styles/component.wxss";

.poster-carousel {
  position: relative;
  margin-bottom: 20rpx;
}

/* 尺寸档位来自 `preview-size-tokens.v1` 的 carousel 组（rpx）：
   sm 200rpx / md 240rpx / lg 310rpx。组件根类 `poster-carousel--{{size}}` 决定档位。
   基础高度保留原硬编码 300rpx，未传 size 的旧工程视觉不回归。 */
.poster-swiper {
  height: 300rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 34rpx rgba(35, 35, 35, 0.16);
}

.poster-carousel--sm .poster-swiper {
  height: 200rpx;
}

.poster-carousel--md .poster-swiper {
  height: 240rpx;
}

.poster-carousel--lg .poster-swiper {
  height: 310rpx;
}

.poster-slide {
  position: relative;
  height: 100%;
  padding: 36rpx 34rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #fffaf3;
}

.poster-slide--warm {
  background: linear-gradient(135deg, #8c3310 0%, #c2410c 55%, #e9a04a 100%);
}

.poster-slide--green {
  background: linear-gradient(135deg, #123f31 0%, #1f6f54 58%, #7fae8f 100%);
}

.poster-slide--ink {
  background: linear-gradient(135deg, #10192b 0%, #1d4e89 62%, #5b86b8 100%);
}

.poster-image-wrap {
  position: absolute;
  inset: 0;
}

.poster-image {
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

.poster-eyebrow {
  position: relative;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.82;
}

.poster-title {
  position: relative;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.poster-sub {
  position: relative;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.poster-empty {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--color-bg);
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.poster-error {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--color-muted);
  text-align: center;
}