        "lineStart": 47,
        "lineEnd": 62,
        "code": "<view class=\"mine__identities\">\n        <view\n          wx:for=\"{{identityOptions}}\"\n          wx:key=\"key\"\n          class=\"mine__identity {{identity.key === item.key ? 'mine__identity--active' : ''}}\"\n          data-key=\"{{item.key}}\"\n          bind:tap=\"onSwitchIdentity\"\n        >\n          <view class=\"mine__identity-main\">\n            <text class=\"mine__identity-label\">{{item.label}}</text>\n            <text class=\"mine__identity-desc\">{{item.description}}</text>\n          </view>\n          <view wx:if=\"{{identity.key === item.key}}\" class=\"mine__identity-badge\">当前</view>\n          <view wx:elif=\"{{switching === item.key}}\" class=\"mine__identity-badge mine__identity-badge--busy\">切换中</view>\n        </view>\n      </view>"
      }
    ]
  },
