    ],
    "uiBlockBlueprint": {
      "suggestedId": "mode-section",
      "displayName": "用餐方式选择区",
      "props": [
        {
          "name": "mode",
          "type": "string",
          "required": false,
          "description": "当前履约方式 DINE_IN / TAKEAWAY"
        },
        {
          "name": "dineInEnabled",
          "type": "boolean",
          "required": false,
          "description": "门店是否支持堂食"
        },
        {
          "name": "takeawayEnabled",
          "type": "boolean",
          "required": false,
          "description": "门店是否支持到店自取"
        },
        {
          "name": "tableName",
          "type": "string",
          "required": false,
          "description": "当前桌号；为空且堂食时展示桌号选择"
        },
        {
          "name": "tableRequired",
          "type": "boolean",
          "required": false,
          "description": "堂食是否必须桌号"
        },
        {
          "name": "tableOptions",
          "type": "array",
          "required": false,
          "description": "演示桌号数组，元素含 id 与 name"
        }
      ],
      "events": [
        {
          "name": "change",
          "payload": [
            "mode"
          ],
          "description": "用户切换履约方式"
        },
        {
          "name": "pickTable",
          "payload": [
            "id",
            "name"
          ],
          "description": "用户选择演示桌号"
        }
      ],
      "promotionSteps": [
        "组件内部继续复用 fulfillment-switch，不复制其实现",
        "桌号条件渲染与选项都来自 props，不读全局状态",
        "登记 registry 并在 Base 页面声明后再进入视图包"
      ]
    }
  },
  "constraints": [
    "桌号选择只在 mode=DINE_IN 且 tableName 为空时出现",
