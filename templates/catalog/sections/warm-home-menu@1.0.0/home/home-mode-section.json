  "reuse": {
    "level": "promote-to-ui-block",
    "reason": "区块同时包含 Base 组件与自有桌号选择器，直接复制会丢失 props 契约与桌号条件逻辑。",
    "whenToUse": [
      "首屏需要让顾客选择堂食或自取",
      "需要在堂食缺桌号时快速补桌号"
    ],
    "avoidWhen": [
