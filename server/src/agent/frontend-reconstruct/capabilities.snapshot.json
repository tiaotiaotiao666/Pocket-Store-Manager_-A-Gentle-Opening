        "takeawayEnabled",
        "value"
      ],
      "events": [
        "change"
      ]
    },
    "order-card": {
      "props": [
        "actingId",
        "actingStatus",
        "actionable",
        "order",
        "role"
      ],
      "events": [
        "advance",
        "cancel",
        "open",
        "pay"
      ]
    },
    "product-card": {
      "props": [
        "disabled",
        "product",
        "quantity"
      ],
      "events": [
        "add",
        "openDetail",
        "remove"
      ]
    },
    "product-detail": {
      "props": [
        "product",
        "quantity",
        "visible"
      ],
      "events": [
        "add",
        "close",
        "remove"
      ]
    },
    "state-view": {
      "props": [
        "actionText",
        "description",
        "state",
        "title"
      ],
      "events": [
        "retry"
      ]
    },
    "store-header": {
      "props": [
        "address",
        "businessHours",
        "compact",
        "mode",
        "storeName",
        "tableName"
