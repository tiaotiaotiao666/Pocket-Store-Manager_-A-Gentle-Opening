{
  "schemaDocVersion": "schema-doc.v1",
  "contract": "component-catalog.v1",
  "status": "frozen",
  "description": "面向 Agent 的组件库读取契约。catalog 是 Base 组件、已登记 UI Block、Feature Pack 组件、页面装配关系、FrontendPack 布局与可复用区块的确定性投影，不是第二份源码；源码与 Manifest 是唯一事实源。",
  "roots": {
    "index": "templates/catalog/index.json",
    "curation": "templates/catalog/curation.v1.json",
    "components": "templates/catalog/components/<id>.json",
    "pages": "templates/catalog/pages/<pageId>.json",
    "layouts": "templates/catalog/layouts/<packId>@<version>.json",
    "sections": "templates/catalog/sections/<packId>@<version>/<pageId>/<sectionId>.json",
    "sectionPages": "templates/catalog/sections/<packId>@<version>/<pageId>/index.json"
  },
  "indexRequired": [
    "schemaVersion",
    "catalogVersion",
    "generatedFrom",
    "readOrder",
    "counts",
    "categories",
    "components",
    "pages",
    "layouts",
    "sections",
    "gaps"
  ],
  "componentRequired": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "category",
    "summary",
    "sourceKind",
    "source",
    "runtime",
    "interface",
    "usage",
    "pages",
    "slots",
    "dataModel",
    "styles",
    "constraints",
    "knownLimits",
    "preview",
    "verify"
  ],
  "pageRequired": [
    "schemaVersion",
    "pageId",
    "title",
    "audience",
    "required",
    "source",
    "components",
    "slots",
    "controller",
    "pageJson"
  ],
  "layoutRequired": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "displayName",
    "source",
    "pages",
    "requiresSlots",
    "constraints",
    "preview"
  ],
  "sectionRequired": [
    "schemaVersion",
    "id",
    "displayName",
    "summary",
    "layout",
    "pageSource",
    "pageId",
    "order",
    "locator",
    "source",
    "template",
    "components",
    "slots",
    "bindings",
    "controller",
    "styles",
    "reuse",
    "constraints",
    "knownLimits",
    "verify"
  ],
  "sectionPageIndexRequired": [
    "schemaVersion",
    "layout",
    "pageSource",
    "pageId",
    "source",
    "counts",
    "sections"
  ],
  "reuseLevels": [
    "direct-wxml",
    "base-component-use",
    "slot-only",
    "promote-to-ui-block"
  ],
  "rules": [
    "catalog 只能由 scripts/component-catalog.cjs 生成，禁止手写生成物。",
    "每个组件卡的 source.files 必须真实存在，source.digest 必须与当前源码目录一致。",
    "interface.props/events 必须与组件实现双向一致；事件 payload 必须与 triggerEvent detail 一致。",
    "页面卡只能引用 catalog 中存在的组件；usingComponents 与 WXML 实际标签必须闭合。",
    "区块卡必须给出可定位的 selector/componentTag/slotId 之一，并保留原始 WXML 片段与样式规则；同一 selector 命中多处时必须用 occurrence 单点定位。",
    "区块卡的 pageSource 只能是 base-page 或 frontend-pack-page；base-page 卡是改写该页视图前的参考实现，不代表该页当前由视图包覆盖。",
    "区块卡绑定的每个事件处理函数必须存在于对应 Base 页面控制器；controller.verified=false 直接拒绝生成。",
    "区块的 reuse.level 只能是 direct-wxml、base-component-use、slot-only、promote-to-ui-block 之一；promote-to-ui-block 必须提供 uiBlockBlueprint。",
    "catalog 不得包含绝对路径、密钥、Token、内网地址或外部 URL。",
    "卡片是读取视图，不进入 Composer 资产解析，不改变 Plan 语义。"
  ]
}