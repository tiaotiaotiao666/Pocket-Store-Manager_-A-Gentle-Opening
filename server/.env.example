# 本文件只用于本地开发。真实密钥只放在 server/.env 或云端密钥管理系统。
NODE_ENV=development
PORT=3000
DESKTOP_ORIGIN=http://127.0.0.1:5173

# ---------------------------------------------------------------
# B2：监听来源 / CORS 白名单 / 桌面会话 / 模型额度护栏
# ---------------------------------------------------------------
# 监听地址：默认只对本机开放（127.0.0.1）。
# 改成 0.0.0.0 或网卡 IP（局域网访问）时必须同时设 AGENT_REQUIRE_AUTH=true，
# 否则服务启动即报错 —— 不存在「非 production 就匿名」的远程模型通道。
SERVER_HOST=127.0.0.1
# 额外允许的浏览器来源（逗号分隔）；与 DESKTOP_ORIGIN 合并成 CORS 白名单。
# 没配置时只用本地开发默认值（127.0.0.1:5173 / localhost:5173 / app://desktop）。
CORS_ALLOWED_ORIGINS=
# 桌面短期本地会话：桌面端自动向 POST /api/v1/desktop/session 申领，
# 桌面自己持有并以 Bearer 调模型接口；不需要用户手工填任何密钥。
DESKTOP_SESSION_TTL_SECONDS=900
DESKTOP_SESSION_ISSUE_PER_MINUTE=10
# 模型接口额度护栏：每个来源每分钟上限 / 入口同时进行中的上限（0 = 关闭）。
# AGENT_MAX_CONCURRENT 只保护 Agent HTTP 入口（超限先排队，排队预算耗尽才 429），
# 它不参与上游模型并发计算，也不能替代下面的 MODEL_* 调度器。
AGENT_RATE_LIMIT_PER_MINUTE=120
AGENT_MAX_CONCURRENT=3

# ---------------------------------------------------------------
# 上游模型并发（ModelCallScheduler，桌面 direct 与 HTTP 共用一套配额）
# ---------------------------------------------------------------
# 最多同时 3 次模型请求（同一口径：进程内 3 槽 + 跨进程全局令牌，两边合计 ≤3）。
# 只允许 1–3；>3 或非法值会被收敛到 3 并打印可见警告。
MODEL_MAX_CONCURRENT=3
# 模型请求排队预算（毫秒，30000–600000，默认 180000）；排队超时返回 MODEL_QUEUE_TIMEOUT。
MODEL_QUEUE_WAIT_MS=180000
# 跨进程全局令牌目录：留空 = 系统临时目录下的 smart-store-model-slots。
# 桌面进程与服务端进程必须指向同一目录，才能保证 HTTP + direct 合计 ≤3。
MODEL_UPSTREAM_TOKEN_DIR=


# 本地 MySQL 8（ZIP 免安装实例）。生产改为华为云 RDS 连接串。
DATABASE_URL="mysql://smart_store:smart_store_dev@127.0.0.1:3306/smart_store"
TEST_DATABASE_URL="mysql://smart_store:smart_store_dev@127.0.0.1:3306/smart_store_test"

# 缓存：auto=优先 Redis，连接失败降级内存；redis=仅 Redis；memory=仅内存。
REDIS_URL=redis://127.0.0.1:6379
CACHE_DRIVER=auto

# 会话
SESSION_TTL_SECONDS=604800

# 演示开关：生产环境必须为 false，启动时会被强制校验。
ALLOW_DEMO_LOGIN=true
ALLOW_DEMO_PAYMENT=true

# 微信小程序（可留空；留空时仅能使用 demo 登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 演示身份（仅服务端种子/登录模拟使用，不得下发给顾客端）
DEMO_OWNER_OPEN_ID=demo-owner-001
DEMO_STAFF_OPEN_ID=demo-staff-001
DEMO_CUSTOMER_OPEN_ID=demo-customer-001

# 模型代理（生成器能力，B 套餐不依赖）
IMAGE_PROVIDER_NAME=not-configured
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL_NAME=
VISION_MODEL_NAME=
IMAGE_API_TIMEOUT_MS=60000
# ---------------------------------------------------------------
# DeepSeek Agent（docs/agent-turn-contract.md 的 agent-turn.v1）
# 真实 API Key 只允许存在 server/.env 或云端密钥管理系统：
# 不写入前端 .env、VITE_*、日志、错误响应、仓库或导出工程。
# 留空时 POST /api/v1/agent/turn 返回 503 DEEPSEEK_NOT_CONFIGURED，不会回退到本地 Mock。
# ---------------------------------------------------------------
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 视觉模型：agent 请求携带图片时使用（纯文本仍走 DEEPSEEK_MODEL）。默认 deepseek-flash。
# 注意：若网关要求模型名带命名空间前缀（如 cn:deepseek-v4.1-flash），这里必须写成
# 与 DEEPSEEK_MODEL 同样带前缀的名字；否则带图请求会被上游判为未知模型（400），
# 最终表现为界面上的"服务暂时不可用"。
DEEPSEEK_VISION_MODEL=deepseek-flash
# Agent JSON 请求体上限（字节）：默认 2 MiB，允许 256 KiB ~ 8 MiB。
# v2 图片以 base64 传输，超过上限返回 413 AGENT_BODY_TOO_LARGE；其它路由仍为 100kb。
AGENT_MAX_BODY_BYTES=2097152
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=1200

# 多轮 Agent（agent-run.v1，POST /api/v1/agent/run）运行上限。
# 触达上限时仍返回 200，由 trace.stopReason 说明原因（max_model_calls / max_tool_calls / time_limit）。
AGENT_RUN_MAX_STEPS=6
AGENT_RUN_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT_MS=60000

# 未认证联调开关：只允许 development/test 使用；
# production 必须为 true，否则启动时拒绝（见 env.validation.ts）。
AGENT_REQUIRE_AUTH=true