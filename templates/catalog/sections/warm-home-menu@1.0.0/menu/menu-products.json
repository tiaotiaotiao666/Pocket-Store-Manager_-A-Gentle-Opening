  "template": {
    "occurrences": 1,
    "rootTag": "scroll-view",
    "snippets": [
      {
        "lineStart": 63,
        "lineEnd": 83,
        "code": "<scroll-view class=\"fp-menu__list\" scroll-y>\r\n        <view wx:if=\"{{products.length > 0}}\" class=\"fp-menu__products\">\r\n          <view wx:for=\"{{products}}\" wx:key=\"id\" class=\"fp-menu__product\">\r\n            <product-card\r\n              product=\"{{item}}\"\r\n              quantity=\"{{quantityMap[item.id] || 0}}\"\r\n              disabled=\"{{item.available === false}}\"\r\n              bind:add=\"onProductAdd\"\r\n              bind:remove=\"onProductRemove\"\r\n              bind:openDetail=\"onOpenDetail\"\r\n            />\r\n          </view>\r\n        </view>\r\n        <state-view\r\n          wx:else\r\n          state=\"empty\"\r\n          title=\"这个分类还没有上架菜品\"\r\n          description=\"换一个分类看看，或稍后下拉刷新\"\r\n        />\r\n        <view class=\"fp-menu__spacer\"></view>\r\n      </scroll-view>"
      }
    ]
  },
