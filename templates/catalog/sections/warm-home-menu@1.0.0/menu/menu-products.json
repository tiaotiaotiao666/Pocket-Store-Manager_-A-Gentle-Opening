  "reuse": {
    "level": "promote-to-ui-block",
    "reason": "列表容器把滚动、空态与卡片网格打包，是菜单页密度最高的区块；直接复制容易漏掉空态与底部占位。",
    "whenToUse": [
      "菜单页需要可滚动的菜品列表",
      "需要同时处理空分类与长列表"
    ],
    "avoidWhen": [
      "需要分组吸顶或双列瀑布流时，先扩展布局契约"
    ],
    "uiBlockBlueprint": {
      "suggestedId": "product-grid",
      "displayName": "菜品滚动列表",
