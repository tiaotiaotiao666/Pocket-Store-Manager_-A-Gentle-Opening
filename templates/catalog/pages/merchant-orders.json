    },
    {
      "tag": "loading-block",
      "componentId": "loading-block",
      "mode": "conditional",
      "sourceLine": 85,
      "usage": "<loading-block wx:if=\"{{ordersLoading && orders.length === 0}}\" text=\"正在拉取订单\" />"
    },
    {
      "tag": "order-card",
      "componentId": "order-card",
      "mode": "always",
      "sourceLine": 96,
      "usage": "<order-card order=\"{{item}}\" role=\"MERCHANT\" actionable=\"{{true}}\" acting-id=\"{{orderActingIds[item.id] ? item.id : ''}}\" acting-status=\"{{orderActingIds[item.id] || ''}}\" bind:open=\"onOpenOrder\" bind"
