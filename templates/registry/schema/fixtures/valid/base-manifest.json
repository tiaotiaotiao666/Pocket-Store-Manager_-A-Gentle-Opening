{
  "schemaVersion": "base.manifest.v1",
  "identity": { "id": "ordering-base", "version": "1.0.0" },
  "entry": {
    "root": "src",
    "files": ["app.js", "app.json", "app.wxss", "sitemap.json"],
    "assets": []
  },
  "pages": [
    { "pageId": "home", "path": "pages/home", "required": true, "audience": "customer" },
    { "pageId": "menu", "path": "pages/menu", "required": true, "audience": "customer" },
    { "pageId": "checkout", "path": "pages/checkout", "required": true, "audience": "customer" },
    { "pageId": "orders", "path": "pages/orders", "required": true, "audience": "customer" },
    { "pageId": "order-detail", "path": "pages/order-detail", "required": true, "audience": "customer" },
    { "pageId": "mine", "path": "pages/mine", "required": true, "audience": "customer" },
    { "pageId": "merchant-orders", "path": "pages/merchant-orders", "required": true, "audience": "merchant" }
  ],
  "themeTokens": [
    { "key": "pageBackground", "cssVar": "--store-page-background", "type": "color", "required": true },
    { "key": "primaryColor", "cssVar": "--store-primary-color", "type": "color", "required": true, "contrastWith": "pageBackground" },
    { "key": "accentColor", "cssVar": "--store-accent-color", "type": "color", "required": true, "contrastWith": "pageBackground" },
    { "key": "textColor", "cssVar": "--store-text-color", "type": "color", "required": true, "contrastWith": "pageBackground" }
  ],
  "layouts": ["page-shell"],
  "services": ["services/request.js", "services/platform.js"],
  "builtinComponents": ["store-header", "state-view", "loading-block", "error-banner"],
  "excludedCapabilities": ["ad-slot", "coupon", "poster-carousel"],
  "storeConfigSchema": "store.generated.v2",
  "slots": [
    {
      "slotId": "home-hero",
      "pageId": "home",
      "maxItems": 1,
      "accepts": ["feature-pack", "ui-block"],
      "required": false
    },
    {
      "slotId": "home-marketing",
      "pageId": "home",
      "maxItems": 2,
      "accepts": ["feature-pack"],
      "required": false
    },
    {
      "slotId": "menu-aside",
      "pageId": "menu",
      "maxItems": 1,
      "accepts": ["ui-block"],
      "required": false
    }
  ],
  "release": { "stage": "stable", "verifiedRecipes": ["order-classic@1.0.0"] }
}