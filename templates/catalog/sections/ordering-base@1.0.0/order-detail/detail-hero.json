        "lineStart": 25,
        "lineEnd": 42,
        "code": "<view wx:if=\"{{order}}\" class=\"detail__hero\">\n      <view class=\"detail__hero-top\">\n        <view class=\"detail__hero-id\">\n          <text class=\"detail__hero-label\">订单号</text>\n          <text class=\"detail__hero-number\">#{{order.shortId}}</text>\n        </view>\n        <text class=\"detail__hero-time\">{{order.createdAtFullText}}</text>\n      </view>\n      <order-status status=\"{{order.status}}\" payment-status=\"{{order.paymentStatus}}\" />\n      <view class=\"detail__hero-foot\">\n        <view class=\"detail__hero-mode\">\n          <text>{{order.fulfillmentText}}</text>\n          <text class=\"detail__hero-dot\">·</text>\n          <text>{{order.itemSummary || '无明细'}}</text>\n        </view>\n        <text class=\"detail__hero-total\">{{order.totalText}}</text>\n      </view>\n    </view>"
      }
