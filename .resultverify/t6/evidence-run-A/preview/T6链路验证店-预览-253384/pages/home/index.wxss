.home {
  padding-top: 32rpx;
}

.home__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.home__brand {
  display: flex;
  flex-direction: column;
}

.home__eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-primary);
  text-transform: uppercase;
}

.home__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.home__identity {
  display: flex;
  align-items: center;
  max-width: 240rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home__identity-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: var(--color-success);
}

.home__error {
  margin-top: 24rpx;
}

.home__retry {
  margin-top: 24rpx;
}

.home__scene-hint {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(47, 125, 79, 0.09);
  color: var(--color-success);
  font-size: 22rpx;
}

.home__section {
  margin-top: 34rpx;
}

.home__tables {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.home__tables-label {
  margin-right: 16rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.home__table {
  margin-right: 14rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  font-weight: 600;
}

.home__table--active {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.home__tables-hint {
  font-size: 22rpx;
  color: var(--color-muted);
}

.home__tables-retry {
  margin-left: 14rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-primary);
}

.home__cta {
  margin-top: 36rpx;
  letter-spacing: 2rpx;
}

.home__cta-arrow {
  margin-left: 14rpx;
  font-size: 30rpx;
}

.home__notice {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fdf0e4;
  border: 2rpx solid rgba(232, 106, 23, 0.16);
}

.home__notice-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.home__notice-text {
  flex: 1;
  font-size: 24rpx;
  color: #8a5a2b;
}

.home__notice-arrow {
  font-size: 22rpx;
  color: #a8691f;
}

.home__order {
  margin-bottom: 18rpx;
}

.home__merchant {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--color-text) 0%, #3a3430 100%);
  color: var(--color-surface);
  box-shadow: 0 14rpx 32rpx rgba(35, 35, 35, 0.2);
}

.home__merchant-body {
  display: flex;
  flex-direction: column;
}

.home__merchant-title {
  font-size: 30rpx;
  font-weight: 700;
}

.home__merchant-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 250, 243, 0.62);
}

.home__merchant-arrow {
  font-size: 40rpx;
  color: rgba(255, 250, 243, 0.6);
}

.home__foot {
  margin-top: 44rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(138, 129, 120, 0.7);
}
