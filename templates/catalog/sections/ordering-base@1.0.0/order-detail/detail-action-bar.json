      {
        "lineStart": 110,
        "lineEnd": 120,
        "code": "<view wx:if=\"{{!payResult && order && (order.canPay || order.canCancel || merchantActions.length > 0)}}\" class=\"detail__bar\">\n    <view wx:if=\"{{order.canCancel}}\" class=\"detail__bar-ghost\" bind:tap=\"onCancel\">\n      {{acting && actionLabel === 'cancel' ? '处理中…' : '取消订单'}}\n    </view>\n    <view wx:if=\"{{order.canPay}}\" class=\"detail__bar-primary\" bind:tap=\"onPay\">\n      {{acting && actionLabel === 'pay' ? '处理中…' : '演示模拟支付'}}\n    </view>\n    <view wx:if=\"{{role === 'MERCHANT' && merchantActions.length > 0}}\" class=\"detail__bar-primary\" bind:tap=\"onAdvance\" data-status=\"{{merchantActions[0].toStatus}}\">\n      {{acting && actionLabel === merchantActions[0].toStatus ? '处理中…' : merchantActions[0].label}}\n    </view>\n  </view>"
      }
    ]
  },
