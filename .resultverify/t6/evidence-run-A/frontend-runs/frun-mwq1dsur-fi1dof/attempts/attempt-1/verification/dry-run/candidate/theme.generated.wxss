page {
  --store-page-background: #F7F3EC;
  --store-primary-color: #B34A0F;
  --store-accent-color: #9C2E12;
  --store-text-color: #232323;
  --store-tab-bar-background: #FFFDF9;
  --store-tab-bar-color: #8A8178;
  --store-tab-bar-selected-color: #B34A0F;
