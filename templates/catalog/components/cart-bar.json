  "interface": {
    "props": [
      {
        "name": "submitting",
        "type": "boolean",
        "required": false,
        "defaultValue": false,
        "description": "提交中状态"
      },
      {
        "name": "totalCents",
        "type": "number",
        "required": true,
        "defaultValue": 0,
        "description": "合计金额，整数分"
      },
      {
        "name": "totalQuantity",
        "type": "number",
        "required": true,
        "defaultValue": 0,
        "description": "合计数量"
      }
    ],
    "events": [
      {
        "name": "checkout",
        "payload": [
          "totalCents",
          "totalQuantity"
        ],
        "description": "去结算"
      },
      {
        "name": "expand",
        "payload": [],
        "description": "展开购物车"
      }
    ]
  },
  "usage": {
    "tag": "cart-bar",
    "wxmlExample": "<cart-bar total-cents=\"{{cartSummary.totalCents}}\" total-quantity=\"{{cartSummary.totalQuantity}}\" submitting=\"{{false}}\" bind:expand=\"onExpandCart\" bind:checkout=\"onCheckout\" />",
    "whenToUse": [
      "菜单页需要常驻的购物车入口",
      "需要在不离开菜单的情况下看到合计金额"
    ],
    "avoidWhen": [
      "需要编辑购物车行项目时，配合 cart-panel 使用",
      "结算页不需要底部购物车条"
    ],
    "notes": [
      "templates/components/cart-bar/1.0.0 是它的登记副本"
    ]
