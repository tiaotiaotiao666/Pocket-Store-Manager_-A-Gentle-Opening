    "snippets": [
      {
        "lineStart": 12,
        "lineEnd": 31,
        "code": "<view class=\"product-page__body surface-card\">\r\n      <view class=\"product-page__topline\">\r\n        <text class=\"product-page__eyebrow\">本店精选</text>\r\n        <text wx:if=\"{{product.available === false}}\" class=\"product-page__soldout\">暂时售罄</text>\r\n      </view>\r\n      <text class=\"product-page__name\">{{product.name}}</text>\r\n      <text class=\"product-page__description\">{{product.description || '门店用心制作，欢迎品尝。'}}</text>\r\n      <view class=\"product-page__divider\"></view>\r\n      <view class=\"product-page__buyrow\">\r\n        <view class=\"product-page__price\"><text>¥</text><text>{{amount}}</text></view>\r\n        <view class=\"product-page__stepper\">\r\n          <view class=\"product-page__step {{quantity > 0 ? '' : 'product-page__step--off'}}\" bind:tap=\"onRemove\">−</view>\r\n          <text class=\"product-page__quantity\">{{quantity}}</text>\r\n          <view class=\"product-page__step product-page__step--add {{product.available === false ? 'product-page__step--disabled' : ''}}\" bind:tap=\"onAdd\">+</view>\r\n        </view>\r\n      </view>\r\n      <view class=\"primary-button product-page__add {{product.available === false ? 'primary-button--off' : ''}}\" bind:tap=\"onAdd\">\r\n        {{product.available === false ? '暂不可售' : '加入购物车'}}\r\n      </view>\r\n    </view>"
      }
    ]
  },
