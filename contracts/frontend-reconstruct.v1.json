{
  "$comment": [
    "frontend-reconstruct.v1 的唯一机器可读契约源。",
    "server（TS 校验器）、desktop（CJS 执行侧校验器）、scripts（Composer/能力快照）都从这里生成常量，",
    "任何一侧都不得再自己维护同义常量。改这里之后必须跑 `node scripts/frontend-contract.cjs --write`",
    "重新生成，并用 `node scripts/frontend-contract.cjs --check` 确认没有漂移。",
    "版本升级规则：不兼容变更必须升 contractVersion / draftSchemaVersion，不得静默改语义。"
  ],
  "contractVersion": "frontend-reconstruct.v1",
  "draftSchemaVersion": "frontend-pack-draft.v1",
  "factsVersion": "frontend-facts.v1",
  "pageFactsVersion": "frontend-page-facts.v1",
  "enums": {
    "targetPages": ["home", "menu"],
    "clientSurfaces": ["desktop"],
    "clientPhases": ["template-pick", "frontend-reconstruct"],
    "themeTokenKeys": [
      "pageBackground",
      "primaryColor",
      "accentColor",
      "textColor",
      "tabBarBackground",
      "tabBarColor",
      "tabBarSelectedColor"
    ],
    "sizeSteps": ["sm", "md", "lg"],
    "sizeKeys": ["homeHero", "productCard", "carousel"],
    "regionTypes": [
      "header",
      "hero",
      "nav",
      "list",
      "grid",
      "card",
      "form",
      "banner",
      "footer",
      "other"
    ],
    "layoutKinds": ["single-column", "two-column", "grid", "list", "poster"],
    "draftNodeTypes": ["component", "slot", "container", "text", "button"],
    "toolNames": [
      "get_frontend_capabilities",
      "check_frontend_coverage",
      "propose_frontend_draft",
      "repair_frontend_draft"
    ],
    "stopReasons": [
      "final_answer",
      "needs_input",
      "rejected",
      "max_model_calls",
      "max_tool_calls",
      "loop_detected",
      "time_limit",
      "aborted"
    ],
    "responseStatuses": ["planned", "needs-input", "rejected"],
    "states": [
      "idle",
      "analyzing",
      "planning",
      "awaiting-capability-confirmation",
      "generating",
      "validating",
      "verifying-runtime",
      "ready",
      "partial",
      "rejected",
      "failed",
      "adopted",
      "cancelled"
    ],
    "repairIssueCodes": [
      "DRAFT_SCHEMA_INVALID",
      "DRAFT_UNKNOWN_COMPONENT",
      "DRAFT_UNKNOWN_EVENT",
      "DRAFT_UNKNOWN_DATA_PATH",
      "DRAFT_STYLE_INVALID",
      "DRAFT_PAGE_JSON_INVALID",
      "SLOT_ANCHOR_MISSING",
      "DRY_RUN_FAILED",
      "MINI_CHECK_FAILED",
      "CONSISTENCY_FAILED"
    ],
    "draftErrorCodes": {
      "schema": "DRAFT_SCHEMA_INVALID",
      "component": "DRAFT_UNKNOWN_COMPONENT",
      "event": "DRAFT_UNKNOWN_EVENT",
      "dataPath": "DRAFT_UNKNOWN_DATA_PATH",
      "style": "DRAFT_STYLE_INVALID",
      "pageJson": "DRAFT_PAGE_JSON_INVALID"
    }
  },
  "limits": {
    "maxBodyBytes": 2097152,
    "maxUtteranceChars": 500,
    "maxPresentationPatchBytes": 16384,
    "maxPages": 2,
    "maxRegionsPerPage": 32,
    "maxRegionDepth": 3,
    "maxRegionChildren": 12,
    "maxMustKeep": 32,
    "maxBindings": 64,
    "maxUnknownRegions": 24,
    "maxLowConfidence": 24,
    "maxInferredInteractions": 16,
    "maxUnsupported": 16,
    "maxDegradations": 16,
    "maxQuestions": 8,
    "maxQuestionChars": 200,
    "maxSummaryChars": 240,
    "maxReasonChars": 200,
    "maxLabelChars": 64,
    "maxDraftPages": 2,
    "maxDraftNodesPerPage": 48,
    "maxDraftDepth": 4,
    "maxContainerChildren": 12,
    "maxComponentProps": 8,
    "maxComponentEvents": 8,
    "maxDraftStringChars": 120,
    "maxDisplayNameChars": 40,
    "maxButtonLabelChars": 16,
    "maxNavTitleChars": 20,
    "maxRepairRounds": 2,
    "maxRepairIssues": 8,
    "maxModelCalls": 8,
    "maxToolCalls": 16,
    "maxWallClockMs": 120000,
    "maxTraceToolCalls": 16,
    "maxRequiredCapabilities": 32,
    "maxCoverageRisks": 16,
    "maxFactsEntries": 128
  },
  "patterns": {
    "requestId": "^fr-[A-Za-z0-9][A-Za-z0-9._-]{0,60}$",
    "runId": "^frun-[A-Za-z0-9][A-Za-z0-9._-]{0,60}$",
    "projectId": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "packId": "^[a-z][a-z0-9-]{1,63}$",
    "version": "^\\d+\\.\\d+\\.\\d+$",
    "regionId": "^[a-z][a-z0-9-]{0,31}$",
    "lowercaseId": "^[a-z][a-z0-9-]{0,63}$",
    "propId": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
    "eventId": "^[A-Za-z][A-Za-z0-9-]{0,31}$",
    "action": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9]{0,31}$",
    "dataPath": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*){1,7}$",
    "capability": "^(page|component|slot|action|data):[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "questionField": "^[a-z][A-Za-z0-9.]{0,63}$",
    "provider": "^[a-z][a-z0-9-]{0,39}$",
    "model": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
    "hexColor": "^#[0-9A-Fa-f]{6}$",
    "controlChar": "[\\u0000-\\u001f\\u007f-\\u009f]",
    "controlCharNarrow": "[\\u0000-\\u001f\\u007f]"
  },
  "forbiddenTextPatterns": [
    { "source": "[<>]", "flags": "" },
    { "source": "\\{\\{|\\}\\}", "flags": "" },
    { "source": "javascript:", "flags": "i" },
    { "source": "vbscript:", "flags": "i" },
    { "source": "data:", "flags": "i" },
    { "source": "https?://", "flags": "i" },
    { "source": "^//", "flags": "" },
    { "source": "^/", "flags": "" },
    { "source": "\\\\", "flags": "" },
    { "source": "\\.\\.", "flags": "" }
  ],
  "inferredForbiddenTokens": ["action:", "page:", "route:", "/pages/"],
  "keys": {
    "draft": ["schemaVersion", "displayName", "pages"],
    "draftPage": ["pageId", "nodes", "styles", "pageJson"],
    "component": ["type", "componentId", "props", "events"],
    "slot": ["type", "slotId"],
    "container": ["type", "style", "children"],
    "text": ["type", "textToken", "style"],
    "button": ["type", "label", "action", "style"],
    "dataProp": ["kind", "dataPath"],
    "literalProp": ["kind", "value"],
    "layoutStyle": [
      "direction",
      "align",
      "justify",
      "gap",
      "padding",
      "radius",
      "width",
      "minHeight",
      "backgroundColorToken",
      "borderColorToken"
    ],
    "textStyle": ["size", "weight", "colorToken"],
    "draftPageJson": [
      "navigationBarTitleText",
      "navigationBarBackgroundColor",
      "navigationBarTextStyle",
      "backgroundColor",
      "enablePullDownRefresh"
    ],
    "packPageJson": [
      "navigationBarTitleText",
      "enablePullDownRefresh",
      "disableScroll",
      "backgroundColor",
      "backgroundTextStyle",
      "usingComponents"
    ],
    "packPageJsonEmitted": [
      "navigationBarTitleText",
      "enablePullDownRefresh",
      "backgroundColor"
    ]
  }
}
