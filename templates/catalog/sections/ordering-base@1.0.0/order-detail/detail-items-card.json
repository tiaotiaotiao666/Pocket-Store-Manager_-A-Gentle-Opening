    "snippets": [
      {
        "lineStart": 67,
        "lineEnd": 89,
        "code": "<view wx:if=\"{{order}}\" class=\"surface-card detail__card\">\n      <view class=\"detail__card-head\">\n        <text class=\"detail__card-title\">菜品明细</text>\n        <text class=\"detail__card-extra\">{{order.items.length}} 项</text>\n      </view>\n      <view class=\"detail__divider\"></view>\n      <view wx:for=\"{{order.itemViews}}\" wx:key=\"productId\" class=\"detail__item\">\n        <view class=\"detail__item-main\">\n          <text class=\"detail__item-name\">{{item.name}}</text>\n          <text class=\"detail__item-unit\">{{item.unitPriceText}} × {{item.quantity}}</text>\n        </view>\n        <text class=\"detail__item-line\">{{item.lineTotalText}}</text>\n      </view>\n      <view class=\"detail__divider\"></view>\n      <view class=\"detail__total\">\n        <text class=\"detail__total-label\">合计</text>\n        <text class=\"detail__total-value\">{{order.totalText}}</text>\n      </view>\n      <view wx:if=\"{{order.noteText}}\" class=\"detail__note\">\n        <text class=\"detail__note-label\">备注</text>\n        <text class=\"detail__note-text\">{{order.noteText}}</text>\n      </view>\n    </view>"
      }
    ]
  },
