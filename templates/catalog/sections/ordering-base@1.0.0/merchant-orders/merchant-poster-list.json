    "rootTag": "view",
    "snippets": [
      {
        "lineStart": 321,
        "lineEnd": 338,
        "code": "<view wx:else class=\"merchant__poster-list\">\r\n        <view wx:for=\"{{posters}}\" wx:key=\"id\" class=\"surface-card merchant__poster-card\">\r\n          <image wx:if=\"{{item.imageUrl}}\" class=\"merchant__poster-image\" src=\"{{item.imageUrl}}\" mode=\"aspectFill\" />\r\n          <view wx:else class=\"merchant__poster-image merchant__poster-image--empty\">{{item.product.name}}</view>\r\n          <view class=\"merchant__poster-body\">\r\n            <text class=\"merchant__product-name\">{{item.title}}</text>\r\n            <text class=\"merchant__product-desc\">{{item.subtitle || item.product.name}} · ¥{{item.product.amountText}}</text>\r\n            <text class=\"merchant__poster-product\">跳转商品：{{item.product.name}}</text>\r\n            <view wx:if=\"{{isOwner}}\" class=\"merchant__poster-actions\">\r\n              <switch checked=\"{{item.active}}\" color=\"#E86A17\" disabled=\"{{productWriting}}\" data-id=\"{{item.id}}\" bindchange=\"onTogglePoster\" />\r\n              <button class=\"merchant__text-button\" size=\"mini\" data-id=\"{{item.id}}\" disabled=\"{{productWriting}}\" bind:tap=\"onOpenPosterForm\">编辑</button>\r\n              <button class=\"merchant__text-button\" size=\"mini\" data-index=\"{{index}}\" data-direction=\"-1\" disabled=\"{{productWriting || index === 0}}\" bind:tap=\"onMovePoster\">上移</button>\r\n              <button class=\"merchant__text-button\" size=\"mini\" data-index=\"{{index}}\" data-direction=\"1\" disabled=\"{{productWriting || index === posters.length - 1}}\" bind:tap=\"onMovePoster\">下移</button>\r\n              <button class=\"merchant__text-button merchant__delete-button\" size=\"mini\" data-id=\"{{item.id}}\" disabled=\"{{productWriting}}\" bind:tap=\"onDeletePoster\">删除</button>\r\n            </view>\r\n          </view>\r\n        </view>\r\n      </view>"
      }
    ]
  },
