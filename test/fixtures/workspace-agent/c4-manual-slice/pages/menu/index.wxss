.menu {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

.menu__top {
  padding: 20rpx 24rpx 0;
}

.menu__switch {
  margin-top: 18rpx;
}

.menu__tables {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(35, 35, 35, 0.04);
}

.menu__tables-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.menu__tables-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

.menu__tables-picked {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.menu__tables-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.menu__tables-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.menu__tables-list {
  display: flex;
  align-items: center;
}

.menu__table {
  flex: 0 0 auto;
  margin-right: 12rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 22rpx;
  font-weight: 600;
}

.menu__table--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.menu__tables-hint {
  font-size: 22rpx;
  color: var(--color-muted);
}

.menu__tables-retry {
  margin-left: 14rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-primary);
}

.menu__error {
  padding: 28rpx 24rpx;
}

.menu__retry {
  margin-top: 22rpx;
}

.menu__body {
  display: flex;
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.menu__list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx 0 18rpx;
  box-sizing: border-box;
}

.menu__banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, var(--color-text) 0%, #3c3531 100%);
  color: var(--color-surface);
}

.menu__banner-text {
  display: flex;
  flex-direction: column;
}

.menu__banner-title {
  font-size: 30rpx;
  font-weight: 700;
}

.menu__banner-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 250, 243, 0.58);
}

.menu__banner-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 243, 0.14);
  font-size: 21rpx;
}

.menu__products {
  margin-top: 18rpx;
}

.menu__product {
  margin-bottom: 18rpx;
}

.menu__spacer {
  height: 220rpx;
}

/* C4 人工切片：仅视觉层；不改页面数据/事件/插槽。 */
.c4-menu {
  --c4-accent: #b45309;
}

.c4-menu__hero {
  margin: 16rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 2rpx solid #fed7aa;
  display: flex;
  flex-direction: column;
}

.c4-menu__hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #9a3412;
}

.c4-menu__hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.c4-menu .menu__nav-host {
  margin: 8rpx 12rpx 0;
}

.c4-menu .menu__product {
  padding: 8rpx 0;
}
