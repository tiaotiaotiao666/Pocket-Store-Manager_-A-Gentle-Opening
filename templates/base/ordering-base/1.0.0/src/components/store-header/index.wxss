@import "../../styles/component.wxss";

.store-header {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 44rpx;
  background: linear-gradient(135deg, var(--color-text) 0%, #46403a 58%, #6b5540 100%);
  color: var(--color-surface);
  box-shadow: 0 16rpx 40rpx rgba(47, 42, 37, 0.22);
}

.store-header--compact {
  padding: 28rpx 28rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 42, 37, 0.16);
}

.store-header__glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(232, 106, 23, 0.55) 0%, rgba(232, 106, 23, 0) 68%);
}

.store-header__body {
  position: relative;
  z-index: 1;
}

.store-header__eyebrow {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 250, 243, 0.78);
}

.store-header__dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f3a55f;
}

.store-header__table {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 243, 0.16);
  color: var(--color-surface);
  font-size: 20rpx;
  letter-spacing: 0;
}

.store-header__name {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.store-header--compact .store-header__name {
  font-size: 36rpx;
  margin-top: 10rpx;
}

.store-header__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 250, 243, 0.72);
}

.store-header__sep {
  margin: 0 10rpx;
}