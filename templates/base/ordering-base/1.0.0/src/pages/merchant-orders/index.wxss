.merchant {
  padding-top: 20rpx;
}

.merchant__head {
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1f2a2e 0%, #33413f 100%);
  color: #f3f5f2;
  box-shadow: 0 16rpx 36rpx rgba(31, 42, 46, 0.24);
}

.merchant__head-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.merchant__head-main {
  display: flex;
  flex-direction: column;
}

.merchant__eyebrow {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #8fc0a9;
}

.merchant__title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.merchant__role {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(143, 192, 169, 0.16);
  color: #a8d5bf;
  font-size: 21rpx;
  font-weight: 600;
}

.merchant__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: rgba(243, 245, 242, 0.55);
}

.merchant__polling {
  color: rgba(168, 213, 191, 0.8);
}

.merchant__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(243, 245, 242, 0.12);
}

.merchant__refresh {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(243, 245, 242, 0.14);
  font-size: 22rpx;
  font-weight: 600;
}

.merchant__poll-switch {
  display: flex;
  align-items: center;
}

.merchant__poll-label {
  margin-right: 8rpx;
  font-size: 21rpx;
  color: rgba(243, 245, 242, 0.65);
}

.merchant__denied {
  margin-top: 40rpx;
}

.merchant__error {
  margin-top: 20rpx;
}

.merchant__tabs {
  display: flex;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(35, 35, 35, 0.06);
}

.merchant__tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

.merchant__tab--active {
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(35, 35, 35, 0.08);
}

.merchant__segments {
  display: flex;
  margin-top: 20rpx;
}

.merchant__segment {
  margin-right: 14rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(35, 35, 35, 0.05);
  font-size: 24rpx;
  color: var(--color-muted);
}

.merchant__segment--active {
  background: var(--color-text);
  color: var(--color-surface);
  font-weight: 700;
}

.merchant__orders {
  margin-top: 22rpx;
}

.merchant__order {
  margin-bottom: 20rpx;
}

.merchant__pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
  padding: 0 4rpx 20rpx;
}

.merchant__total {
  font-size: 22rpx;
  color: var(--color-muted);
}

.merchant__more {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(35, 35, 35, 0.06);
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.merchant__more--disabled {
  opacity: 0.55;
}

.merchant__product-summary {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(35, 35, 35, 0.04);
}

.merchant__product-stat {
  margin-right: 22rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.merchant__product-stat--ok {
  color: var(--color-success);
}

.merchant__product-stat--off {
  color: var(--color-danger);
}

.merchant__owner-actions {
  display: flex;
  margin-top: 20rpx;
}

.merchant__owner-button {
  margin: 0 14rpx 0 0;
  background: var(--color-text);
  color: var(--color-surface);
  font-size: 23rpx;
}

.merchant__editor {
  margin-top: 18rpx;
  padding: 22rpx;
}

.merchant__editor-title {
  font-size: 27rpx;
  font-weight: 700;
}

.merchant__field {
  margin-top: 18rpx;
}

.merchant__field-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-muted);
}

.merchant__input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(35, 35, 35, 0.12);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 25rpx;
}

.merchant__textarea {
  min-height: 120rpx;
}

.merchant__picker {
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(35, 35, 35, 0.12);
  border-radius: 12rpx;
  background: var(--color-surface);
  font-size: 25rpx;
}

.merchant__quick-category {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(35, 35, 35, 0.04);
}

.merchant__quick-button {
  margin: 14rpx 0 0;
}

.merchant__switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 24rpx;
}

.merchant__editor-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.merchant__primary-button {
  margin: 0 14rpx 0 0;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: 23rpx;
}

.merchant__secondary-button {
  margin: 0;
  background: rgba(35, 35, 35, 0.06);
  color: var(--color-text);
  font-size: 23rpx;
}

.merchant__text-button {
  margin: 0;
  padding: 0 12rpx;
  background: rgba(35, 35, 35, 0.05);
  color: var(--color-primary);
  font-size: 21rpx;
  line-height: 2;
}

.merchant__empty {
  margin-top: 24rpx;
}

.merchant__products {
  margin-top: 22rpx;
}

.merchant__category {
  margin-bottom: 24rpx;
}

.merchant__category-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 12rpx;
}

.merchant__category-name {
  font-size: 27rpx;
  font-weight: 700;
}

.merchant__category-actions {
  display: flex;
  align-items: center;
}

.merchant__category-count {
  margin-right: 12rpx;
  font-size: 21rpx;
  color: var(--color-muted);
}

.merchant__category-editor {
  margin: 0 4rpx 14rpx;
}

.merchant__product-list {
  padding: 4rpx 22rpx;
}

.merchant__product-wrap {
  border-bottom: 2rpx solid rgba(230, 222, 210, 0.55);
}

.merchant__product-wrap:last-child {
  border-bottom: none;
}

.merchant__product {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 20rpx 0;
}

.merchant__product-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.merchant__product-image {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 144rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #f2e9dd;
}

.merchant__product-image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a27654;
  font-size: 22rpx;
}

.merchant__product-title {
  display: flex;
  align-items: center;
  min-width: 0;
}

.merchant__product-name {
  font-size: 26rpx;
  font-weight: 600;
}

.merchant__product-tag {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(178, 58, 47, 0.1);
  color: var(--color-danger);
  font-size: 19rpx;
}

.merchant__product-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--color-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.merchant__product-price {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.merchant__price-button {
  align-self: flex-start;
  margin-top: 8rpx;
}

.merchant__price-editor {
  margin-top: 10rpx;
}

.merchant__product-editor {
  margin: 0 0 20rpx 162rpx;
  padding: 20rpx;
}

.merchant__image-upload {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.merchant__image-preview {
  width: 180rpx;
  height: 132rpx;
  margin: 0 14rpx 10rpx 0;
  border-radius: 14rpx;
  background: #f1e9de;
}

.merchant__image-preview--wide {
  flex: 0 0 100%;
  width: 100%;
  height: 300rpx;
  margin-right: 0;
}

.merchant__upload-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.merchant__poster-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 4rpx 16rpx;
}

.merchant__poster-hint {
  display: block;
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.merchant__poster-list {
  margin-top: 22rpx;
}

.merchant__poster-card {
  overflow: hidden;
  margin-bottom: 20rpx;
}

.merchant__poster-image {
  display: block;
  width: 100%;
  height: 330rpx;
  background: linear-gradient(135deg, #a84420 0%, #e28b48 55%, #f3c27a 100%);
}

.merchant__poster-image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 250, 243, 0.9);
  font-size: 30rpx;
}

.merchant__poster-body {
  padding: 20rpx 22rpx 22rpx;
}

.merchant__poster-product {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.merchant__poster-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
}

.merchant__poster-actions switch,
.merchant__poster-actions button {
  margin: 0 10rpx 8rpx 0;
}

.merchant__delete-button {
  color: var(--color-danger);
}

.merchant__foot {
  margin-top: 32rpx;
  padding: 0 6rpx;
  font-size: 20rpx;
  color: rgba(138, 129, 120, 0.8);
}
