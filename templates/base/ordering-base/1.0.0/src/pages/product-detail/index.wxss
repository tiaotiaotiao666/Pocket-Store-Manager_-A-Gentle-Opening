.product-page {
  padding-top: 22rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.product-page__hero {
  height: 560rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #f2d2b8, #e79c65);
}

.product-page__image { width: 100%; height: 100%; }

.product-page__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: rgba(137, 65, 29, .45);
  font-size: 150rpx;
  font-weight: 700;
}

.product-page__body {
  position: relative;
  margin-top: -36rpx;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 30rpx;
}

.product-page__topline,
.product-page__buyrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-page__eyebrow { color: var(--color-primary); font-size: 21rpx; font-weight: 600; }
.product-page__soldout { color: var(--color-danger); font-size: 21rpx; }
.product-page__name { display: block; margin-top: 14rpx; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.product-page__description { display: block; margin-top: 12rpx; color: var(--color-muted); font-size: 25rpx; line-height: 1.7; }
.product-page__divider { height: 1rpx; margin: 28rpx 0; background: var(--color-border); }
.product-page__price { color: var(--color-primary); font-size: 38rpx; font-weight: 700; }
.product-page__price text:first-child { margin-right: 4rpx; font-size: 23rpx; }
.product-page__stepper { display: flex; align-items: center; }
.product-page__step { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 2rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); font-size: 35rpx; }
.product-page__step--add { background: var(--color-primary); color: #fff; }
.product-page__step--off { opacity: .35; }
.product-page__step--disabled { opacity: .4; }
.product-page__quantity { min-width: 62rpx; text-align: center; font-size: 27rpx; font-weight: 700; }
.product-page__add { margin-top: 32rpx; }
.product-page__note { margin-top: 28rpx; color: var(--color-muted); font-size: 21rpx; text-align: center; }
.product-page__error { margin-top: 30rpx; }
