# 本文件只用于本地开发。真实密钥只放在 server/.env 或云端密钥管理系统。
NODE_ENV=development
PORT=3000
DESKTOP_ORIGIN=http://127.0.0.1:5173

# 本地 MySQL 8（ZIP 免安装实例）。生产改为华为云 RDS 连接串。
DATABASE_URL="mysql://smart_store:smart_store_dev@127.0.0.1:3306/smart_store"
TEST_DATABASE_URL="mysql://smart_store:smart_store_dev@127.0.0.1:3306/smart_store_test"

# 缓存：auto=优先 Redis，连接失败降级内存；redis=仅 Redis；memory=仅内存。
REDIS_URL=redis://127.0.0.1:6379
CACHE_DRIVER=auto

# 会话
SESSION_TTL_SECONDS=604800

# 演示开关：生产环境必须为 false，启动时会被强制校验。
ALLOW_DEMO_LOGIN=true
ALLOW_DEMO_PAYMENT=true

# 微信小程序（可留空；留空时仅能使用 demo 登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 演示身份（仅服务端种子/登录模拟使用，不得下发给顾客端）
DEMO_OWNER_OPEN_ID=demo-owner-001
DEMO_STAFF_OPEN_ID=demo-staff-001
DEMO_CUSTOMER_OPEN_ID=demo-customer-001

# 模型代理（生成器能力，B 套餐不依赖）
IMAGE_PROVIDER_NAME=not-configured
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL_NAME=
VISION_MODEL_NAME=
IMAGE_API_TIMEOUT_MS=60000
# ---------------------------------------------------------------
# DeepSeek Agent（docs/agent-turn-contract.md 的 agent-turn.v1）
# 真实 API Key 只允许存在 server/.env 或云端密钥管理系统：
# 不写入前端 .env、VITE_*、日志、错误响应、仓库或导出工程。
# 留空时 POST /api/v1/agent/turn 返回 503 DEEPSEEK_NOT_CONFIGURED，不会回退到本地 Mock。
# ---------------------------------------------------------------
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 视觉模型：agent 请求携带图片时使用（纯文本仍走 DEEPSEEK_MODEL）。默认 deepseek-flash。
DEEPSEEK_VISION_MODEL=deepseek-flash
# Agent JSON 请求体上限（字节）：默认 2 MiB，允许 256 KiB ~ 8 MiB。
# v2 图片以 base64 传输，超过上限返回 413 AGENT_BODY_TOO_LARGE；其它路由仍为 100kb。
AGENT_MAX_BODY_BYTES=2097152
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=1200

# 未认证联调开关：只允许 development/test 使用；
# production 必须为 true，否则启动时拒绝（见 env.validation.ts）。
AGENT_REQUIRE_AUTH=false