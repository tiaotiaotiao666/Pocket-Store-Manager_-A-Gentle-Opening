<view class="menu">
  <view class="menu__top">
    <store-header
      store-name="{{store.name || '菜单'}}"
      table-name="{{tableName}}"
      business-hours="{{store.businessHours}}"
      mode="{{mode}}"
      address="{{store.address}}"
      compact="{{true}}"
    />
    <view class="menu__switch">
      <fulfillment-switch
        value="{{mode}}"
        dine-in-enabled="{{store.fulfillment.dineIn}}"
        takeaway-enabled="{{store.fulfillment.takeaway}}"
        table-name="{{tableName}}"
        table-required="{{true}}"
        bind:change="onModeChange"
      />
      <view wx:if="{{mode === 'DINE_IN' && !tableName}}" class="menu__tables">
        <text class="menu__tables-label">演示桌号</text>
        <view
          wx:for="{{tableOptions}}"
          wx:key="id"
          class="menu__table"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bind:tap="onPickTable"
        >
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <state-view wx:if="{{loading}}" state="loading" title="正在加载菜单" />

  <view wx:elif="{{error}}" class="menu__error">
    <error-banner message="{{error}}" action="{{errorAction}}" request-id="{{requestId}}" bind:retry="onRetry" bind:close="onRetry" />
    <view class="ghost-button menu__retry" bind:tap="onRetry">重新加载</view>
  </view>

  <view wx:else class="menu__body">
    <category-nav categories="{{categories}}" active-id="{{activeCategoryId}}" bind:select="onSelectCategory" />
    <scroll-view class="menu__list" scroll-y>
      <view class="menu__banner">
        <view class="menu__banner-text">
          <text class="menu__banner-title">{{activeCategoryName || '全部菜品'}}</text>
          <text class="menu__banner-sub">{{products.length}} 道菜 · 价格为整数分展示</text>
        </view>
        <view class="menu__banner-tag">{{tableName ? tableName + ' 桌' : '自取'}}</view>
      </view>

      <view wx:if="{{products.length > 0}}" class="menu__products">
        <view wx:for="{{products}}" wx:key="id" class="menu__product">
          <product-card
            product="{{item}}"
            quantity="{{quantityMap[item.id] || 0}}"
            disabled="{{item.available === false}}"
            bind:add="onProductAdd"
            bind:remove="onProductRemove"
            bind:openDetail="onOpenDetail"
          />
        </view>
      </view>
      <state-view
        wx:else
        state="empty"
        title="这个分类还没有上架菜品"
        description="换一个分类看看，或稍后下拉刷新"
      />

      <view class="menu__spacer"></view>
    </scroll-view>
  </view>

  <cart-bar
    total-cents="{{cartSummary.totalCents}}"
    total-quantity="{{cartSummary.totalQuantity}}"
    submitting="{{false}}"
    bind:expand="onExpandCart"
    bind:checkout="onCheckout"
  />

  <cart-panel
    visible="{{cartVisible}}"
    items="{{cartSummary.items}}"
    total-cents="{{cartSummary.totalCents}}"
    total-quantity="{{cartSummary.totalQuantity}}"
    submitting="{{false}}"
    bind:close="onPanelClose"
    bind:add="onPanelAdd"
    bind:remove="onPanelRemove"
    bind:checkout="onCheckout"
  />

  <product-detail
    visible="{{detailVisible}}"
    product="{{detailProduct}}"
    quantity="{{detailQuantity}}"
    bind:close="onDetailClose"
    bind:add="onDetailAdd"
    bind:remove="onDetailRemove"
  />
</view>