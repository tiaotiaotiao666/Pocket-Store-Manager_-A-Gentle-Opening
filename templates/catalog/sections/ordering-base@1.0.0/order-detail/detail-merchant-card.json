      {
        "lineStart": 91,
        "lineEnd": 107,
        "code": "<view wx:if=\"{{order && merchantActions.length > 0}}\" class=\"surface-card detail__card detail__merchant\">\n      <view class=\"detail__card-head\">\n        <text class=\"detail__card-title\">店主操作</text>\n        <text class=\"detail__card-extra\">当前身份可用</text>\n      </view>\n      <view class=\"detail__merchant-actions\">\n        <view\n          wx:for=\"{{merchantActions}}\"\n          wx:key=\"toStatus\"\n          class=\"detail__merchant-btn {{item.tone === 'primary' ? 'detail__merchant-btn--primary' : item.tone === 'success' ? 'detail__merchant-btn--success' : 'detail__merchant-btn--danger'}}\"\n          data-status=\"{{item.toStatus}}\"\n          bind:tap=\"onAdvance\"\n        >\n          {{acting && actionLabel === item.toStatus ? '处理中…' : item.label}}\n        </view>\n      </view>\n    </view>"
      }
    ]
