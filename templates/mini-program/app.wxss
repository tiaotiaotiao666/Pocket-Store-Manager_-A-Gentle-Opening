page{--store-bg:#FAF7F1;--store-primary:#E78A35;--store-accent:#286957;--store-text:#29332F;background:var(--store-bg);color:var(--store-text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:32rpx}.card{background:#fffefa;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.muted{color:#85877f;font-size:24rpx}.title{font-size:38rpx;font-weight:700}.button{background:var(--store-primary);color:white;border-radius:18rpx;padding:22rpx;text-align:center;margin-top:22rpx}.row{display:flex;align-items:center;justify-content:space-between}.price{color:var(--store-primary);font-weight:700}.pill{color:var(--store-accent);background:#e8efe9;border-radius:18rpx;padding:6rpx 14rpx}
