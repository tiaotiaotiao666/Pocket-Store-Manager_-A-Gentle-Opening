    "snippets": [
      {
        "lineStart": 22,
        "lineEnd": 60,
        "code": "<view class=\"surface-card checkout__card\">\r\n        <view class=\"checkout__row\">\r\n          <text class=\"checkout__row-label\">用餐方式</text>\r\n          <text class=\"checkout__row-value\">{{modeText}}</text>\r\n        </view>\r\n        <view class=\"checkout__row\">\r\n          <text class=\"checkout__row-label\">桌号</text>\r\n          <text class=\"checkout__row-value\">{{tableName || '无需桌号'}}</text>\r\n        </view>\r\n        <view class=\"checkout__row\">\r\n          <text class=\"checkout__row-label\">下单身份</text>\r\n          <text class=\"checkout__row-value\">{{identityLabel}}</text>\r\n        </view>\r\n        <view wx:if=\"{{mode === 'DINE_IN'}}\" class=\"checkout__tables\">\r\n          <text class=\"checkout__tables-label\">门店桌号</text>\r\n          <block wx:if=\"{{tablesLoading}}\">\r\n            <text class=\"checkout__tables-hint\">正在读取门店桌号…</text>\r\n          </block>\r\n          <block wx:elif=\"{{tablesError}}\">\r\n            <text class=\"checkout__tables-hint\">{{tablesError}}</text>\r\n            <view class=\"checkout__tables-retry\" bind:tap=\"onRetryTables\">重试</view>\r\n          </block>\r\n          <block wx:elif=\"{{tableOptions.length === 0}}\">\r\n            <text class=\"checkout__tables-hint\">当前门店还没有可用桌号，请联系店员确认</text>\r\n          </block>\r\n          <block wx:else>\r\n            <view\r\n              wx:for=\"{{tableOptions}}\"\r\n              wx:key=\"id\"\r\n              class=\"checkout__table {{tableName === item.name ? 'checkout__table--active' : ''}}\"\r\n              data-id=\"{{item.id}}\"\r\n              data-name=\"{{item.name}}\"\r\n              bind:tap=\"onPickTable\"\r\n            >\r\n              {{item.name}}\r\n            </view>\r\n          </block>\r\n        </view>\r\n      </view>"
      }
    ]
  },
