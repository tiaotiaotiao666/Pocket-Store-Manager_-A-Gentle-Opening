<view class="page fp-cand-page fp-cand-page--home">
  <view class="fp-cand__root">
    <!-- @slot:home-hero -->
    <!-- @slot-fallback:home-hero -->
    <!-- @slot-fallback:home-hero:end -->
    <!-- @slot:home-hero:end -->
    <store-header class="fp-cand__component fp-cand__component-1" address="{{store.address}}" business-hours="{{store.businessHours}}" mode="{{mode}}" store-name="{{store.name}}" table-name="{{tableName}}" />
    <text class="fp-cand__text-2">{{identityLabel}}</text>
    <fulfillment-switch class="fp-cand__component fp-cand__component-3" dine-in-enabled="{{store.fulfillment.dineIn}}" table-name="{{tableName}}" table-required="false" takeaway-enabled="{{store.fulfillment.takeaway}}" value="{{mode}}" bind:change="onModeChange" />
    <view class="fp-cand__box-4">
      <button class="fp-cand__button fp-cand__button-4-0" bind:tap="onPickTable">选择桌号</button>
      <button class="fp-cand__button fp-cand__button-4-1" bind:tap="goMenu">开始点餐</button>
    </view>
    <view class="fp-cand__box-5">
      <text class="fp-cand__text-5-0">{{pendingPaymentCount}}</text>
      <button class="fp-cand__button fp-cand__button-5-1" bind:tap="goOrders">全部订单</button>
    </view>
    <order-card class="fp-cand__component fp-cand__component-6" bind:open="onOpenOrder" />
    <state-view class="fp-cand__component fp-cand__component-7" bind:retry="onRetryTables" />
    <error-banner class="fp-cand__component fp-cand__component-8" bind:retry="onRetry" />
    <view class="fp-cand__box-9">
      <button class="fp-cand__button fp-cand__button-9-0" bind:tap="goMerchant">商家</button>
      <button class="fp-cand__button fp-cand__button-9-1" bind:tap="goMine">我的</button>
    </view>
  </view>
</view>
