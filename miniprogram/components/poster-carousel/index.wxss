.poster-carousel {
  position: relative;
  margin: 26rpx 0 32rpx;
}

.poster-carousel__swiper {
  height: 408rpx;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 44rpx rgba(63, 39, 22, 0.18);
}

.poster-carousel--sm .poster-carousel__swiper { height: 280rpx; }
.poster-carousel--md .poster-carousel__swiper { height: 350rpx; }
.poster-carousel--lg .poster-carousel__swiper { height: 408rpx; }

.poster-carousel__slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #8f4b2e;
}

.poster-carousel__image,
.poster-carousel__fallback,
.poster-carousel__shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.poster-carousel__image { opacity: 0.78; }

.poster-carousel__fallback {
  background: linear-gradient(135deg, #a84420 0%, #e28b48 55%, #f3c27a 100%);
}

.poster-carousel__shade {
  background: linear-gradient(90deg, rgba(27, 21, 18, 0.72) 0%, rgba(37, 26, 19, 0.36) 58%, rgba(37, 26, 19, 0.08) 100%),
    linear-gradient(0deg, rgba(27, 21, 18, 0.42) 0%, transparent 58%);
}

.poster-carousel__copy {
  position: absolute;
  left: 34rpx;
  right: 30rpx;
  bottom: 34rpx;
  display: flex;
  flex-direction: column;
  color: #fffaf3;
}

.poster-carousel__eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 250, 243, 0.84);
}

.poster-carousel__title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.poster-carousel__subtitle {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 250, 243, 0.84);
}

.poster-carousel__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.poster-carousel__price {
  font-size: 30rpx;
  font-weight: 700;
}

.poster-carousel__link {
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #fff;
}
