    "snippets": [
      {
        "lineStart": 3,
        "lineEnd": 35,
        "code": "<view class=\"fp-menu__top\">\r\n      <store-header\r\n        store-name=\"{{store.name || '菜单'}}\"\r\n        table-name=\"{{tableName}}\"\r\n        business-hours=\"{{store.businessHours}}\"\r\n        mode=\"{{mode}}\"\r\n        address=\"{{store.address}}\"\r\n        compact=\"{{true}}\"\r\n      />\r\n      <view class=\"fp-menu__switch\">\r\n        <fulfillment-switch\r\n          value=\"{{mode}}\"\r\n          dine-in-enabled=\"{{store.fulfillment.dineIn}}\"\r\n          takeaway-enabled=\"{{store.fulfillment.takeaway}}\"\r\n          table-name=\"{{tableName}}\"\r\n          table-required=\"{{true}}\"\r\n          bind:change=\"onModeChange\"\r\n        />\r\n        <view wx:if=\"{{mode === 'DINE_IN' && !tableName}}\" class=\"fp-menu__tables\">\r\n          <text class=\"fp-menu__tables-label\">演示桌号</text>\r\n          <view\r\n            wx:for=\"{{tableOptions}}\"\r\n            wx:key=\"id\"\r\n            class=\"fp-menu__table\"\r\n            data-id=\"{{item.id}}\"\r\n            data-name=\"{{item.name}}\"\r\n            bind:tap=\"onPickTable\"\r\n          >\r\n            {{item.name}}\r\n          </view>\r\n        </view>\r\n      </view>\r\n    </view>"
      }
    ]
