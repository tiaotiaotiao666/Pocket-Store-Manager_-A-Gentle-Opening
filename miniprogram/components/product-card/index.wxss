@import "../../styles/component.wxss";

.product-card {
  display: flex;
  padding: 22rpx;
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(35, 35, 35, 0.05);
}

.product-card--disabled {
  opacity: 0.62;
}

.product-card__media {
  position: relative;
  flex: none;
  /* 尺寸档位来自 Composer 输出的 --store-product-card-min-height（rpx，md=140rpx）。
     兜底值 168rpx 即原硬编码值，未重新导出的旧工程视觉不变。 */
  width: var(--store-product-card-min-height, 168rpx);
  height: var(--store-product-card-min-height, 168rpx);
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(140deg, #f7ded0 0%, #f3c9ac 100%);
}

.product-card__image {
  width: 100%;
  height: 100%;
}

.product-card__initial {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 56rpx;
  font-weight: 700;
  color: rgba(232, 106, 23, 0.55);
}

.product-card__soldout {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(35, 35, 35, 0.72);
  color: #fff;
  font-size: 18rpx;
}

.product-card__main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.product-card__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-card__price {
  display: flex;
  align-items: baseline;
  color: var(--color-primary);
}

.product-card__currency {
  font-size: 22rpx;
  font-weight: 700;
}

.product-card__amount {
  margin-left: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.product-card__stepper {
  display: flex;
  align-items: center;
}

.product-card__step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: 34rpx;
  line-height: 1;
}

.product-card__step--add {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.product-card__step--off {
  opacity: 0.4;
}

.product-card__qty {
  min-width: 52rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}